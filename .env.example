# CivicSignal AI Environment Variables

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# CRITICAL: Service-role key is SERVER-ONLY and must never be exposed to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# LLM Provider Configuration (Optional for demo/fallback mode)
# Supports Gemini or OpenAI
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=mock # Options: "gemini", "openai", "mock"

# Operational Configuration
NODE_ENV=development
PORT=3000
